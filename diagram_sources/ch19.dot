digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.35",nodesep="0.35",ranksep="0.48",splines=polyline,dpi=140,fontname="Noto Sans CJK SC",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#EDF4FB",color="#A9BDD0",fontname="Noto Sans CJK SC",fontsize=16,fontcolor="#17334D",margin="0.19,0.13"];
edge [color="#486B8A",fontname="Noto Sans CJK SC",fontsize=12,fontcolor="#38566F",arrowsize=0.75];
label="第 19 章  异常现场由硬件与软件共同形成";
"event" [label="同步异常或 IRQ\n来源与类型不同",fillcolor="#EDF4FB"];
"hardware" [label="硬件保存返回位置与状态\n选择向量槽",fillcolor="#EDF4FB"];
"vector" [label="VBAR_EL1 对应入口",fillcolor="#EDF4FB"];
"software" [label="kernel_entry 等\n保存通用寄存器与栈现场",fillcolor="#EDF4FB"];
"regs" [label="pt_regs\n本次异常现场",fillcolor="#EDF4FB"];
"handler" [label="C 或架构处理路径",fillcolor="#EDF4FB"];
"exit" [label="恢复现场\n按条件返回内核或用户态",fillcolor="#E7F5EF"];
"event"->"hardware" [label="发生异常"];
"hardware"->"vector" [label="跳转"];
"vector"->"software" [label="入口代码"];
"software"->"regs" [label="构造"];
"regs"->"handler" [label="传递现场"];
"handler"->"exit" [label="处理后"];
note [shape=note,fillcolor="#F2F4F6",fontsize=13,label="CPU 不直接认识 pt_regs，也不自动把全部寄存器写入 C 结构。"];
"exit"->note [style=invis];
}