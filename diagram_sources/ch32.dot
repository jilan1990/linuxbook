digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.35",nodesep="0.35",ranksep="0.48",splines=polyline,dpi=140,fontname="Noto Sans CJK SC",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#EDF4FB",color="#A9BDD0",fontname="Noto Sans CJK SC",fontsize=16,fontcolor="#17334D",margin="0.19,0.13"];
edge [color="#486B8A",fontname="Noto Sans CJK SC",fontsize=12,fontcolor="#38566F",arrowsize=0.75];
label="第 32 章  按最早失败边界缩小故障范围";
"entry" [label="Image 入口是否到达",fillcolor="#EDF4FB"];
"mmu" [label="MMU 后是否继续执行",fillcolor="#EDF4FB"];
"c" [label="start_kernel 是否到达",fillcolor="#EDF4FB"];
"task" [label="PID 1 是否创建并运行",fillcolor="#EDF4FB"];
"file" [label="根视图与候选文件是否正确",fillcolor="#EDF4FB"];
"elf" [label="ELF 现场是否成功安装",fillcolor="#EDF4FB"];
"user" [label="用户入口与输出是否出现",fillcolor="#EDF4FB"];
"debug" [label="停在最早失败边界\n检查输入 条件 与证据",fillcolor="#E7F5EF"];
"entry"->"mmu" [label="是"];
"mmu"->"c" [label="是"];
"c"->"task" [label="是"];
"task"->"file" [label="是"];
"file"->"elf" [label="是"];
"elf"->"user" [label="是"];
"entry"->"debug" [label="否"];
"mmu"->"debug" [label="否"];
"task"->"debug" [label="否"];
"elf"->"debug" [label="否"];
note [shape=note,fillcolor="#F2F4F6",fontsize=13,label="每次仅改一个变量，保存已知可启动基线与构建哈希。"];
"debug"->note [style=invis];
}