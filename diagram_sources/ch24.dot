digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.35",nodesep="0.35",ranksep="0.48",splines=polyline,dpi=140,fontname="Noto Sans CJK SC",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#EDF4FB",color="#A9BDD0",fontname="Noto Sans CJK SC",fontsize=16,fontcolor="#17334D",margin="0.19,0.13"];
edge [color="#486B8A",fontname="Noto Sans CJK SC",fontsize=12,fontcolor="#38566F",arrowsize=0.75];
label="第 24 章  PID 身份与启动执行流的分叉";
"rest" [label="启动任务中的 rest_init",fillcolor="#EDF4FB"];
"p1" [label="创建 PID 1\n入口 kernel_init",fillcolor="#EDF4FB"];
"p2" [label="创建 PID 2\n入口 kthreadd",fillcolor="#EDF4FB"];
"complete" [label="发布依赖\nkthreadd_done",fillcolor="#EDF4FB"];
"wait" [label="PID 1 等待条件\n满足后继续",fillcolor="#EDF4FB"];
"idle" [label="原任务继续\n调度与 idle",fillcolor="#E7F5EF"];
"rest"->"p1" [label="先创建",style=dashed];
"rest"->"p2" [label="后创建",style=dashed];
"p2"->"complete" [label="建立关联状态后"];
"p1"->"wait" [label="获得调度后运行"];
"complete"->"wait" [label="满足同步条件"];
"rest"->"idle" [label="原执行流继续"];
note [shape=note,fillcolor="#F2F4F6",fontsize=13,label="PID 0 不会变成 PID 1；PID 1 后续 exec 才是同一身份更换映像。"];
"idle"->note [style=invis];
}