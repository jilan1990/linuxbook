digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.35",nodesep="0.35",ranksep="0.48",splines=polyline,dpi=140,fontname="Noto Sans CJK SC",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#EDF4FB",color="#A9BDD0",fontname="Noto Sans CJK SC",fontsize=16,fontcolor="#17334D",margin="0.19,0.13"];
edge [color="#486B8A",fontname="Noto Sans CJK SC",fontsize=12,fontcolor="#38566F",arrowsize=0.75];
label="第 17 章  内核中的不同虚拟区域";
"image" [label="镜像映射\n代码 只读数据 可写数据",fillcolor="#EDF4FB"];
"linear" [label="线性映射\n相应 RAM 的规则映射",fillcolor="#EDF4FB"];
"vmalloc" [label="vmalloc 区域\n虚拟连续 不保证物理连续",fillcolor="#EDF4FB"];
"fixmap" [label="fixmap / 早期映射\n特定槽位与访问需求",fillcolor="#EDF4FB"];
"ram" [label="RAM 物理页",fillcolor="#EDF4FB"];
"device" [label="设备寄存器\n需要合适 Device 属性",fillcolor="#E7F5EF"];
"image"->"ram" [label="镜像相关偏移"];
"linear"->"ram" [label="线性规则"];
"vmalloc"->"ram" [label="逐页映射"];
"fixmap"->"ram" [label="特定访问"];
"fixmap"->"device" [label="按用途建立映射"];
note [shape=note,fillcolor="#F2F4F6",fontsize=13,label="不同虚拟区域不能套用同一地址转换公式。"];
"device"->note [style=invis];
}