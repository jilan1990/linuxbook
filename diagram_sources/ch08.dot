digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.35",nodesep="0.35",ranksep="0.48",splines=polyline,dpi=140,fontname="Noto Sans CJK SC",fontsize=20,labelloc=t];
node [shape=box,style="rounded,filled",fillcolor="#EDF4FB",color="#A9BDD0",fontname="Noto Sans CJK SC",fontsize=16,fontcolor="#17334D",margin="0.19,0.13"];
edge [color="#486B8A",fontname="Noto Sans CJK SC",fontsize=12,fontcolor="#38566F",arrowsize=0.75];
label="第 8 章  启动协议约束两类输入";
"boot" [label="前级软件\n固件或启动实现",fillcolor="#EDF4FB"];
"materials" [label="启动材料\nRAM / Image / DTB / 可选归档",fillcolor="#EDF4FB"];
"state" [label="CPU 状态\nEL / MMU / Cache / 屏蔽",fillcolor="#EDF4FB"];
"x0" [label="x0 指向 DTB\nx1～x3 按协议置零",fillcolor="#EDF4FB"];
"entry" [label="Image 入口\n开始内核控制",fillcolor="#EDF4FB"];
"verify" [label="内核按契约使用\n不是任意状态修复器",fillcolor="#E7F5EF"];
"boot"->"materials" [label="准备"];
"boot"->"state" [label="配置"];
"state"->"x0" [label="寄存器约定"];
"materials"->"entry" [label="可访问材料"];
"x0"->"entry" [label="交接"];
"entry"->"verify" [label="启动"];
note [shape=note,fillcolor="#F2F4F6",fontsize=13,label="EFI 与直接启动在交接前有不同流程，本书先研究直接启动。"];
"verify"->note [style=invis];
}